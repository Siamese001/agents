#!/bin/sh
# Native Pre-Push Hook for Antigravity Governance
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "=== [Git Hook] Running Pre-Push Governance Verification ==="

MAIN_REPO="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON_BIN="$REPO_ROOT/.venv/bin/python"
    PYTEST_BIN="$REPO_ROOT/.venv/bin/pytest"
elif [ -x "$MAIN_REPO/.venv/bin/python" ]; then
    PYTHON_BIN="$MAIN_REPO/.venv/bin/python"
    PYTEST_BIN="$MAIN_REPO/.venv/bin/pytest"
else
    PYTHON_BIN="python3"
    PYTEST_BIN="pytest"
fi

CHANGED_FILES=$(git diff --name-only main...HEAD 2>/dev/null || true)

# 1. Turn gates (all modes)
echo "-> 1. Validating all turn gates..."
"$PYTHON_BIN" tools/validate_turn_gates.py --mode all >/dev/null

# 2. Tier 1 commit gate (scoped to changed files when available)
echo "-> 2. Running Tier 1 verify_commit..."
if [ -n "$CHANGED_FILES" ]; then
    # shellcheck disable=SC2086
    "$PYTHON_BIN" tools/verify_commit.py --files $CHANGED_FILES --shard-fast
else
    "$PYTHON_BIN" tools/verify_commit.py --all
fi

# 3. Governance test suite when governance surfaces changed
GOV_TOUCHED=$(printf '%s\n' "$CHANGED_FILES" | grep -E '^(AGENTS\.md|\.agents/|\.githooks/|config/governance/|tools/)' || true)
if [ -n "$GOV_TOUCHED" ] || [ -z "$CHANGED_FILES" ]; then
    echo "-> 3. Running governance test suite..."
    "$PYTEST_BIN" tests/test_turn_gates.py \
      tests/test_hook_dispatch.py \
      tests/test_implementation_plan_governance.py \
      tests/test_hitl_governance_enforcement.py \
      tests/test_model_neutral_naming.py \
      tests/test_unified_agent_architecture.py \
      tests/test_post_merge_cleanup.py \
      --timeout=60 -q
fi

# 4. Fast deterministic Resume & Outreach eval harness gate
echo "-> 4. Running Resume & Outreach eval harness gate..."
"$PYTHON_BIN" ops_scripts/ci/check_eval_harness_promotion_evidence.py --run-offline --fast-dev

echo "=== [Git Hook] All Pre-Push Checks PASSED ==="
