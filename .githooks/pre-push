#!/bin/sh
# Native Pre-Push Hook for Antigravity Governance
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "=== [Git Hook] Running Pre-Push Governance Verification ==="

MAIN_REPO="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)"
if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON_BIN="$REPO_ROOT/.venv/bin/python"
    PYTEST_BIN="$REPO_ROOT/.venv/bin/pytest"
elif [ -x "$MAIN_REPO/.venv/bin/python" ]; then
    PYTHON_BIN="$MAIN_REPO/.venv/bin/python"
    PYTEST_BIN="$MAIN_REPO/.venv/bin/pytest"
else
    PYTHON_BIN="python3"
    PYTEST_BIN="pytest"
fi

# 1. Turn gates (all modes)
echo "-> 1. Validating all turn gates..."
"$PYTHON_BIN" tools/validate_turn_gates.py --mode all

# 2. Active plan validation & wave summary
echo "-> 2. Validating active implementation plan & confirming wave summary table..."
"$PYTHON_BIN" tools/validate_implementation_plan.py


# 3. Tier 1 commit gate
echo "-> 3. Running Tier 1 verify_commit..."
"$PYTHON_BIN" tools/verify_commit.py

# 4. Comprehensive test suite
echo "-> 4. Running governance test suite..."
"$PYTEST_BIN" tests/test_turn_gates.py \
  tests/test_implementation_plan_governance.py \
  tests/test_hitl_governance_enforcement.py \
  tests/test_model_neutral_naming.py \
  tests/test_unified_agent_architecture.py \
  --timeout=60

echo "=== [Git Hook] All Pre-Push Checks PASSED ==="
