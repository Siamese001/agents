#!/bin/sh
# Native Pre-Commit Hook for Antigravity Governance
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "=== [Git Hook] Running Pre-Commit Governance Gates ==="

# 1. Pre-turn mechanical gates
echo "-> 1. Validating turn gates..."
python3 tools/validate_turn_gates.py --mode pre-turn

# 2. Staged implementation plans validation
echo "-> 2. Validating staged implementation plans..."
python3 tools/validate_implementation_plan.py --staged

# 3. Tier 1 quality check (verify_commit.py)
echo "-> 3. Verifying commit invariants (Tier 1)..."
.venv/bin/python tools/verify_commit.py

# 4. Fast governance regression test suite
echo "-> 4. Running fast governance test suite..."
.venv/bin/pytest tests/test_turn_gates.py \
  tests/test_implementation_plan_governance.py \
  tests/test_hitl_governance_enforcement.py \
  tests/test_model_neutral_naming.py \
  tests/test_unified_agent_architecture.py \
  --timeout=60 -q

echo "=== [Git Hook] All Pre-Commit Checks PASSED ==="
