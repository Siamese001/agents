  "artifact_role_filename_map": {
    "lane_l2_output": "l2_output.json",
    "lane_runtime_payload": "runtime_payload.json",
    "l2_execution_packet": "l2_execution_packet.json",
    "frozen_execution_context": "frozen_execution_context.json",
