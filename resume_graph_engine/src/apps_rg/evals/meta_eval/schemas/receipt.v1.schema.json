{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.local/apps_rg/meta_eval/receipt.v1.schema.json",
  "title": "Apps RG evaluator-validity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "score_groups", "fixture_digests", "grader_cards_digest", "status", "metrics", "observations", "failure_codes", "unknown_reasons", "authority", "record_digest"],
  "properties": {
    "schema_version": {"const": "apps_rg.evaluator_validity_receipt.v1"},
    "gate_id": {"const": "G6"},
    "score_groups": {"const": ["evaluator_validity"]},
    "fixture_digests": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "grader_cards_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "FAIL"]},
    "metrics": {
      "type": "object",
      "required": ["critical_mutation_recall", "critical_grounding_mutation_recall", "critical_provenance_mutation_recall", "clean_control_false_positive_rate", "score_stability", "required_gate_unknown_count", "holdout_leakage_incident_count", "mutation_failure_count"]
    },
    "observations": {"type": "array", "minItems": 1},
    "failure_codes": {"type": "array", "items": {"type": "string"}},
    "unknown_reasons": {"type": "array", "maxItems": 0},
    "authority": {
      "type": "object",
      "required": ["measurement_scope", "machine_critical_grader_validation_complete", "human_agreement_pilot_complete", "human_agreement_thresholds_frozen", "release_authorizing", "promotion_scope"],
      "properties": {
        "measurement_scope": {"const": "SEALED_REPOSITORY_FIXTURES"},
        "human_agreement_pilot_complete": {"const": false},
        "human_agreement_thresholds_frozen": {"const": false},
        "release_authorizing": {"const": false},
        "promotion_scope": {"const": "FUTURE_RUNS_ONLY"}
      }
    },
    "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
