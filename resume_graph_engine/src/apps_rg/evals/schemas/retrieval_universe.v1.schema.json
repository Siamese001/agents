{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-workflow.local/apps_rg/retrieval_universe.v1.schema.json",
  "title": "Sealed full finite retrieval candidate universe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "query_id", "query_text", "target_profile", "section", "graph_lane",
    "employer", "evidence_density", "split", "candidate_count", "candidate_universe", "judging_scope", "k_values",
    "gate_k", "candidates", "query_digest"
  ],
  "properties": {
    "schema_version": {"const": "apps_rg.retrieval_universe.v1"},
    "query_id": {"type": "string", "minLength": 1},
    "query_text": {"type": "string", "minLength": 1},
    "target_profile": {"type": "string", "minLength": 1},
    "section": {"type": "string", "minLength": 1},
    "graph_lane": {"type": "string", "minLength": 1},
    "employer": {"type": "string", "minLength": 1},
    "evidence_density": {"enum": ["SPARSE", "MEDIUM", "DENSE"]},
    "split": {"enum": ["CALIBRATION", "HOLDOUT"]},
    "candidate_count": {"type": "integer", "minimum": 1},
    "candidate_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "candidate_ids", "candidate_count", "manifest_digest"],
      "properties": {
        "authority": {"const": "FROZEN_HUMAN_LABELLED"},
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "candidate_count": {"type": "integer", "minimum": 1},
        "manifest_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"}
      }
    },
    "judging_scope": {"const": "FULL_FINITE_UNIVERSE"},
    "k_values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "gate_k": {"type": "integer", "minimum": 1},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "query_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"}
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "rank", "score", "relevance_grade", "graph_path", "path_binding",
        "jd_concepts", "claim_ids", "employer", "role", "evidence_type", "metric_bearing",
        "hard_negative_class", "critical_hard_negative", "near_duplicate_of", "content_digest"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "rank": {"type": "integer", "minimum": 1},
        "score": {"type": "number"},
        "relevance_grade": {"type": "integer", "minimum": 0, "maximum": 3},
        "graph_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "path_binding": {"enum": ["EXACT", "MISMATCH", "UNKNOWN"]},
        "jd_concepts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "employer": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "metric_bearing": {"type": "boolean"},
        "hard_negative_class": {
          "enum": [
            "NONE", "WRONG_EMPLOYER", "WRONG_ROLE", "WRONG_DATE", "METRIC_SEMANTIC_MISMATCH",
            "SCOPE_MISMATCH", "PROJECTED_NOT_ACHIEVED", "JD_ONLY_NO_EVIDENCE", "DUPLICATE_GRAPH_PATH"
          ]
        },
        "critical_hard_negative": {"type": "boolean"},
        "near_duplicate_of": {"type": ["string", "null"], "minLength": 1},
        "content_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"}
      }
    }
  }
}
