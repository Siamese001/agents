{
  "mcpServers": {
    "gitkraken": {
      "command": "cmd",
      "args": [
        "/c",
        "gk",
        "mcp"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "github": {
      "command": "cmd",
      "args": [
        "/c",
        "if defined GITHUB_PERSONAL_ACCESS_TOKEN (npx -y @modelcontextprotocol/server-github) else (for /f %i in ('gh auth token') do @set GITHUB_PERSONAL_ACCESS_TOKEN=%i&& npx -y @modelcontextprotocol/server-github)"
      ]
    },
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Git\\agentic"
      ]
    },
    "notion": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@notionhq/notion-mcp-server"
      ]
    },
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp",
        "--output-dir",
        "artifacts/mcp/playwright",
        "--output-mode",
        "file"
      ]
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-sqlite",
        "--db-path",
        "C:\\Git\\agentic\\artifacts\\apps_rg\\fact_inventory\\augmented_skills_graph.sqlite"
      ]
    },
    "deepwiki": {
      "serverUrl": "https://mcp.deepwiki.com/mcp"
    }
  }
}
