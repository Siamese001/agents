{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fortknox/apps_evidence_assertion.schema.json",
  "title": "Apps_e2e Evidence Assertion (atomic)",
  "description": "One assertion proves ONE APPS-REQ-NNN row + ONE control + ONE artifact-backed fact. Sibling to certification/schemas/evidence_assertion.schema.json; diverges only in req_id pattern and APPS-specific assertion/artifact classes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assertion_id",
    "req_id",
    "control",
    "assertion_result",
    "assertion_class",
    "generated_by_command",
    "verifier_exit_code",
    "verifier_version",
    "generated_at_utc",
    "artifact_path",
    "artifact_sha256",
    "artifact_class",
    "artifact_payload_pointer",
    "artifact_contains_req_id",
    "artifact_contains_control",
    "row_specific",
    "freshness_hours",
    "proof_payload"
  ],
  "properties": {
    "assertion_id": {
      "type": "string",
      "pattern": "^ASRT-[0-9a-f]{16,64}$"
    },
    "req_id": {"type": "string", "pattern": "^APPS-(REQ|DOM)-\\d{3}$"},
    "control": {"type": "string", "minLength": 1},
    "assertion_result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT_VERIFIED"]
    },
    "assertion_class": {
      "type": "string",
      "enum": [
        "APPS_BUNDLE_EMISSION_ASSERTION",
        "APPS_SPINE_CERTIFIED_ASSERTION",
        "APPS_WAIVER_ASSERTION",
        "APPS_MATRIX_GOVERNANCE_ASSERTION",
        "APPS_NEGATIVE_CONTROL_ASSERTION",
        "APPS_STATIC_CONTRACT_ASSERTION",
        "APPS_POSITIVE_CONTROL_ASSERTION",
        "APPS_DOMAIN_WIRING_ASSERTION",
        "APPS_DOMAIN_GATING_ASSERTION",
        "APPS_DOMAIN_PROOF_ASSERTION"
      ]
    },
    "generated_by_command": {
      "type": "string",
      "minLength": 1,
      "description": "Exact script path that emitted this assertion. Enforced by compiler producer allowlist (constitutional \u00a732 amendment pending W7)."
    },
    "verifier_exit_code": {"type": "integer"},
    "verifier_version": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string"},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_class": {"type": "string", "minLength": 1},
    "artifact_payload_pointer": {"type": "string", "minLength": 1},
    "artifact_contains_req_id": {"type": "boolean"},
    "artifact_contains_control": {"type": "boolean"},
    "row_specific": {"type": "boolean"},
    "freshness_hours": {"type": "integer", "minimum": 1, "maximum": 8760},
    "proof_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "app_name": {
      "type": ["string", "null"],
      "description": "Per-app subject of this assertion when applicable (e.g., APPS-REQ-025 apps_rg). Null for canary and matrix-governance rows."
    },
    "supersedes_assertion_id": {"type": ["string", "null"]},
    "depends_on_assertion_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^ASRT-[0-9a-f]{16,64}$"}
    }
  }
}
