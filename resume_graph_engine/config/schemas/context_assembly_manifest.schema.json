{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextAssemblyManifest",
  "description": "Declarative manifest for C0 context assembly — specifies what evidence to retrieve, how to shape it, and what budget/gates apply. Replaces ad-hoc retrieval wiring in apps_*.",
  "type": "object",
  "required": ["manifest_id", "version", "retrieval"],
  "properties": {
    "manifest_id": {
      "type": "string",
      "description": "Unique identifier for this manifest (e.g. 'apps_research-v1')."
    },
    "version": {
      "type": "integer",
      "description": "Schema version (currently 1).",
      "const": 1
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what this manifest retrieves."
    },
    "feature_flag": {
      "type": "string",
      "description": "Feature flag name to gate this manifest behind (empty = always active)."
    },
    "retrieval": {
      "type": "object",
      "required": ["sources", "assembly"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "collection"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["vector", "graph", "keyword", "memory", "tool_result"],
                "description": "Retrieval source kind."
              },
              "collection": {
                "type": "string",
                "description": "Collection or index name to query."
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Weight for hybrid fusion (default 0.5)."
              },
              "top_k": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Number of results to retrieve from this source."
              }
            }
          }
        },
        "assembly": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["full_prefetch", "jit_identifier", "hybrid"],
              "description": "Assembly mode: full_prefetch = load all up front; jit_identifier = carry refs, dereference on demand; hybrid = must-use prefetch + optional JIT."
            },
            "reranker": {
              "type": "string",
              "description": "Reranker to apply (e.g. 'senior_librarian', 'cross_encoder')."
            },
            "max_chunks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum chunks in the final evidence contract."
            },
            "token_budget": {
              "type": "integer",
              "minimum": 256,
              "description": "Token budget for the assembled context."
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "min_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum coverage score to proceed (default 0.3)."
        },
        "min_must_use": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum must-use chunks required (default 1)."
        },
        "max_refine_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Maximum C0.6 refinement attempts (default 3)."
        },
        "acl_tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "ACL tags required for this manifest's retrieval."
        }
      }
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable context compaction when over budget (default true)."
        },
        "strategy": {
          "type": "string",
          "enum": ["clear_then_summarize", "summarize_only", "prune_only"],
          "description": "Compaction strategy (default 'clear_then_summarize')."
        }
      }
    }
  }
}
