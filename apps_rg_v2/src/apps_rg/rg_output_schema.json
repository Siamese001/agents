{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "apps_rg Resume Generation Output Schema",
  "description": "Schema contract for R0 slot resume generation output",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_name",
    "target_role",
    "target_company",
    "generated_at",
    "sections",
    "citations",
    "gaps",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["master_resume_v2.16"],
      "description": "Schema version for compatibility checking"
    },
    "candidate_name": {
      "type": "string",
      "minLength": 1,
      "description": "Candidate's full name from candidate_facts"
    },
    "target_role": {
      "type": "string",
      "minLength": 1,
      "description": "Target job role from U0"
    },
    "target_company": {
      "type": "string",
      "minLength": 1,
      "description": "Target company from U0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp of generation"
    },
    "headline_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "description": "Professional headline from headline lane (export / merge enrichment; X2 x2_headline_executive_length)"
    },
    "contact_info": {
      "type": "object",
      "description": "Contact row aligned with base resume header (DOCX / parity)",
      "properties": {
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "linkedin": { "type": "string" },
        "github": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "required": ["summary", "experience", "skills", "education"],
      "properties": {
        "summary": {
          "type": "object",
          "required": ["text", "word_count"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 10,
              "maxLength": 1350,
              "description": "Professional summary text (exactly six sentences; SSOT max 150 words)"
            },
            "word_count": {
              "type": "integer",
              "minimum": 10,
              "maximum": 150,
              "description": "Word count for validation (SSOT EXEC_SUMMARY_MAX_WORDS)"
            }
          }
        },
        "experience": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "description": "Professional experience roles (chronological)",
          "items": {
            "allOf": [
              {
                "type": "object",
                "required": ["title", "company", "dates", "bullets"],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 2
                  },
                  "company": {
                    "type": "string",
                    "minLength": 2
                  },
                  "location": {
                    "type": "string",
                    "description": "City, State or 'Remote'"
                  },
                  "dates": {
                    "type": "string",
                    "pattern": "^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+\\d{4}\\s*[-–—]\\s*(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)?\\s*(\\d{4}|Present|Current)$|^\\d{4}\\s*[-–—]\\s*(\\d{4}|Present|Current)$|^Pre-2002\\s*[-–—]\\s*(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\\s+\\d{4}$",
                    "description": "Employment period (e.g. 'Jan 2020 – Mar 2022', '2002 – 2009', or aggregated early block 'Pre-2002 – Sep 2002')"
                  },
                  "role_narrative": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 360,
                    "description": "Optional one-sentence role narrative (Unify/IBM; SSOT <=58 words / <=360 chars)"
                  },
                  "bullets": {
                    "type": "array",
                    "maxItems": 6,
                    "description": "Achievement bullets per role (minimum three for standard roles; Early Career Roles may use one)",
                    "items": {
                      "type": "object",
                      "required": ["text"],
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 20,
                          "maxLength": 420,
                          "description": "Bullet text (one achievement; accommodates locked-copy early-career SSOT)"
                        },
                        "source_id": {
                          "type": "string",
                          "description": "Reference to C0 fact_id (optional but preferred)"
                        },
                        "has_metric": {
                          "type": "boolean",
                          "description": "Whether bullet contains quantified outcome"
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "company": { "enum": ["Early Career Roles", "Ernst & Young", "InsurTech Cloud Solutions"] }
                  },
                  "required": ["company"]
                },
                "then": {
                  "properties": {
                    "bullets": { "minItems": 0 }
                  }
                },
                "else": {
                  "properties": {
                    "bullets": { "minItems": 3 }
                  }
                }
              }
            ]
          }
        },
        "projects": {
          "type": "array",
          "maxItems": 3,
          "description": "Significant projects (optional but recommended)",
          "items": {
            "type": "object",
            "required": ["name", "role"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "role": {
                "type": "string",
                "minLength": 2
              },
              "dates": {
                "type": "string",
                "description": "Project duration (optional)"
              },
              "tech_stack": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Technologies used"
              },
              "description": {
                "type": "string",
                "maxLength": 300,
                "description": "Project outcome description"
              },
              "source_id": {
                "type": "string",
                "description": "Reference to C0 project_evidence"
              }
            }
          }
        },
        "skills": {
          "type": "object",
          "description": "Engineering and platform competencies. Résumé and export section title: ENGINEERING & PLATFORM COMPETENCIES (JSON key remains skills for compatibility).",
          "required": ["categories"],
          "properties": {
            "categories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["name", "items"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120,
                    "description": "Skill grouping label (matches base resume facts.skills[].category and lane category_label). Suggested buckets: Languages, Frameworks, Cloud & Infrastructure, Data & ML, Tools & Platforms, Databases, Mobile, DevOps, Other; JD-tailored headings are allowed."
                  },
                  "items": {
                    "type": "array",
                    "maxItems": 8,
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "education": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["degree", "institution"],
            "properties": {
              "degree": {
                "type": "string",
                "minLength": 2
              },
              "major": {
                "type": "string"
              },
              "institution": {
                "type": "string",
                "minLength": 2
              },
              "location": {
                "type": "string"
              },
              "year": {
                "type": "string",
                "pattern": "^\\d{4}$"
              },
              "honors": {
                "type": "string",
                "description": "Graduation distinction or honors (e.g. shown after institution in DOCX)"
              },
              "gpa": {
                "type": "number",
                "minimum": 0,
                "maximum": 4.0
              },
              "relevant_coursework": {
                "type": "array",
                "maxItems": 3,
                "items": { "type": "string" }
              }
            }
          }
        },
        "certifications": {
          "type": "array",
          "description": "Professional certifications (optional)",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "issuer": { "type": "string" },
              "date": { "type": "string" },
              "expires": { "type": "string" }
            }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "description": "Source citations for material claims",
      "items": {
        "type": "object",
        "required": ["fact_id", "section", "claim_text"],
        "properties": {
          "fact_id": { "type": "string" },
          "section": {
            "type": "string",
            "enum": ["summary", "experience", "projects", "skills", "education"]
          },
          "claim_text": {
            "type": "string",
            "description": "The specific claim being cited"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "JD requirements not supported by candidate facts",
      "items": {
        "type": "object",
        "required": ["requirement", "reason"],
        "properties": {
          "requirement": { "type": "string" },
          "reason": {
            "type": "string",
            "enum": ["no_evidence", "insufficient_evidence", "skill_not_demonstrated", "experience_level_mismatch"]
          },
          "suggested_action": {
            "type": "string",
            "enum": ["omit", "user_confirm", "add_evidence"]
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["generation_mode", "template_id", "slot_fingerprints"],
      "properties": {
        "generation_mode": {
          "type": "string",
          "enum": ["strategic_tailor", "tailor_existing", "generate_scratch", "enhance_current"]
        },
        "template_id": { "type": "string" },
        "template_version": { "type": "string" },
        "slot_fingerprints": {
          "type": "object",
          "description": "Hash of each slot for replay/verification",
          "properties": {
            "S0": { "type": "string" },
            "I0": { "type": "string" },
            "C0": { "type": "string" },
            "U0": { "type": "string" },
            "Y0": { "type": "string" },
            "R0": { "type": "string" }
          }
        },
        "quality_scores": {
          "type": "object",
          "properties": {
            "factual_grounding": { "type": "number" },
            "role_alignment": { "type": "number" },
            "ats_compatibility": { "type": "number" },
            "metric_density": { "type": "number" }
          }
        },
        "buzzword_count": {
          "type": "integer",
          "maximum": 2
        },
        "weak_descriptor_count": {
          "type": "integer"
        },
        "metric_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of bullets with metrics"
        }
      }
    }
  },
  "additionalProperties": false,
  
  "definitions": {
    "section_constraints": {
      "type": "object",
      "properties": {
        "summary": {
          "min_lines": 2,
          "max_lines": 4,
          "max_words": 60,
          "required_elements": ["years_experience_or_level", "primary_domains", "key_achievement"]
        },
        "experience": {
          "max_roles": 5,
          "bullets_per_role": { "min": 1, "max": 6 },
          "metric_percentage_min": 60,
          "bullet_pattern": "PowerVerb + Action + Metric + Scope"
        },
        "projects": {
          "max_projects": 3,
          "required_fields": ["name", "role"]
        },
        "skills": {
          "max_total": 25,
          "max_per_category": 8
        }
      }
    }
  }
}
