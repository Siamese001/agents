{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.local/schemas/apps_rg/c03_graph_health_operational_evidence.v2.schema.json",
  "title": "C0.3 graph health operational evidence envelope v2",
  "type": "object",
  "required": [
    "schema_version",
    "envelope_id",
    "producer_registry_version",
    "assembled_at_utc",
    "subject",
    "bindings",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "apps_rg.c03_graph_health_operational_evidence.v2"
    },
    "envelope_id": {
      "$ref": "#/$defs/identifier"
    },
    "producer_registry_version": {
      "const": "apps_rg.c03_graph_operational_producer_registry.v1"
    },
    "assembled_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "integrity_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "required": [
        "candidate_commit_sha",
        "canonical_graph_sha256",
        "health_policy_sha256",
        "health_run_id"
      ],
      "properties": {
        "candidate_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "canonical_graph_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "health_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "health_run_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "role",
        "artifact_root_id",
        "relative_path",
        "sha256"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_root_id": {
          "$ref": "#/$defs/identifier"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "producer_binding": {
      "type": "object",
      "required": [
        "producer_id",
        "producer_schema_version",
        "producer_run_id",
        "cohort_id",
        "cohort_as_of_utc",
        "cohort_closed_at_utc",
        "authority_anchor_id",
        "artifact_refs"
      ],
      "properties": {
        "producer_id": {
          "$ref": "#/$defs/identifier"
        },
        "producer_schema_version": {
          "$ref": "#/$defs/identifier"
        },
        "producer_run_id": {
          "$ref": "#/$defs/identifier"
        },
        "cohort_id": {
          "$ref": "#/$defs/identifier"
        },
        "cohort_as_of_utc": {
          "type": "string",
          "format": "date-time"
        },
        "cohort_closed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "authority_anchor_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "maxProperties": 7,
      "properties": {
        "decision_safe_regression": {
          "$ref": "#/$defs/producer_binding"
        },
        "source_currentness": {
          "$ref": "#/$defs/producer_binding"
        },
        "source_freshness": {
          "$ref": "#/$defs/producer_binding"
        },
        "hitl_approval_coverage": {
          "$ref": "#/$defs/producer_binding"
        },
        "write_audit_coverage": {
          "$ref": "#/$defs/producer_binding"
        },
        "p0_sla_compliance": {
          "$ref": "#/$defs/producer_binding"
        },
        "p1_sla_compliance": {
          "$ref": "#/$defs/producer_binding"
        }
      },
      "additionalProperties": false
    }
  }
}
