{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.local/apps_rg/authoritative/cluster_holdout_controller_receipt.v1.schema.json",
  "title": "Apps RG one-shot cluster holdout controller receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "split", "controller_id", "controller_nonce",
    "execution_id", "source_commit", "controller_plan_digest", "input_bundle_sha256",
    "threshold_freeze_digest", "holdout_retrieval_receipt_digest", "started_at",
    "ended_at", "runtime_invoked", "exit_code", "record_digest"
  ],
  "properties": {
    "schema_version": {"const": "apps_rg.cluster_holdout_controller_receipt.v1"},
    "status": {"const": "PASS"},
    "split": {"const": "HOLDOUT"},
    "controller_id": {"type": "string", "minLength": 1},
    "controller_nonce": {"$ref": "#/$defs/digest"},
    "execution_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "controller_plan_digest": {"$ref": "#/$defs/digest"},
    "input_bundle_sha256": {"$ref": "#/$defs/digest"},
    "threshold_freeze_digest": {"$ref": "#/$defs/digest"},
    "holdout_retrieval_receipt_digest": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "minLength": 1},
    "ended_at": {"type": "string", "minLength": 1},
    "runtime_invoked": {"const": true},
    "exit_code": {"const": 0},
    "record_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
