{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-workflow.local/apps_rg/authoritative/cluster_retrieval_qrels.v1.schema.json",
  "title": "Apps RG graph-evidence cluster retrieval QRELs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "query_id", "universe_digest", "logical_retrieval_unit",
    "authority_bindings", "authority_receipt_file_sha256",
    "reviewer_identity_refs", "adjudicator_identity_ref", "labels", "record_digest"
  ],
  "properties": {
    "schema_version": {"const": "apps_rg.authoritative_cluster_retrieval_qrels.v1"},
    "query_id": {"type": "string", "minLength": 1},
    "universe_digest": {"$ref": "#/$defs/digest"},
    "logical_retrieval_unit": {"const": "graph_evidence_cluster"},
    "authority_bindings": {"$ref": "#/$defs/caseBindings"},
    "authority_receipt_file_sha256": {"$ref": "#/$defs/digest"},
    "reviewer_identity_refs": {"$ref": "#/$defs/reviewerList"},
    "adjudicator_identity_ref": {"type": "string", "pattern": "^human-reviewer://"},
    "labels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cluster_id", "reviewer_identity_refs", "adjudication_status",
          "adjudicator_identity_ref", "relevance_grade", "expected_graph_path",
          "critical_hard_negative", "hard_negative_class",
          "near_duplicate_cluster_id", "jd_concepts", "claim_ids"
        ],
        "properties": {
          "cluster_id": {"type": "string", "minLength": 1},
          "reviewer_identity_refs": {"$ref": "#/$defs/reviewerList"},
          "adjudication_status": {"const": "ADJUDICATED"},
          "adjudicator_identity_ref": {"type": "string", "pattern": "^human-reviewer://"},
          "relevance_grade": {"enum": [0, 1, 2, 3]},
          "expected_graph_path": {"$ref": "#/$defs/stringList", "minItems": 1},
          "critical_hard_negative": {"type": "boolean"},
          "hard_negative_class": {
            "enum": [
              "NONE", "WRONG_EMPLOYER", "WRONG_ROLE", "WRONG_DATE",
              "METRIC_SEMANTIC_MISMATCH", "SCOPE_MISMATCH",
              "PROJECTED_NOT_ACHIEVED", "JD_ONLY_NO_EVIDENCE",
              "DUPLICATE_GRAPH_PATH"
            ]
          },
          "near_duplicate_cluster_id": {
            "anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
          },
          "jd_concepts": {"$ref": "#/$defs/stringList"},
          "claim_ids": {"$ref": "#/$defs/stringList"}
        }
      }
    },
    "record_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reviewerList": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^human-reviewer://"}
    },
    "caseBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_sha256", "cluster_registry_sha256", "corpus_sha256",
        "model_artifact_sha256", "projection_sha256", "runtime_config_sha256",
        "query_sha256", "authority_envelope_sha256"
      ],
      "properties": {
        "graph_sha256": {"$ref": "#/$defs/digest"},
        "cluster_registry_sha256": {"$ref": "#/$defs/digest"},
        "corpus_sha256": {"$ref": "#/$defs/digest"},
        "model_artifact_sha256": {"$ref": "#/$defs/digest"},
        "projection_sha256": {"$ref": "#/$defs/digest"},
        "runtime_config_sha256": {"$ref": "#/$defs/digest"},
        "query_sha256": {"$ref": "#/$defs/digest"},
        "authority_envelope_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
