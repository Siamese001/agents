{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "apps_rg/evals/section_quality_benchmark/executive_summary.schema.json",
  "title": "executive_summary_benchmark_row",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "w14.scaffold.1" },
    "section_id": { "type": "string", "const": "executive_summary" },
    "run_id": { "type": "string" },
    "prompt_hash": { "type": "string" },
    "section_contract_ref": { "type": "string" },
    "output_payload": { "type": "object", "description": "Parsed section output per rg_output_schema" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "factual_support": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Claim ledger alignment; no JD/briefing-as-proof leakage."
        },
        "jd_fit": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Target-role emphasis without JD keyword stuffing."
        },
        "executive_presence": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "SVP / platform-leader narrative density and synthesis (not bullet stacks)."
        },
        "concision": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "4–5 dense sentences in one paragraph; avoids sentence-stacked proof pacing."
        },
        "specificity": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Concrete platform/runtime nouns vs vague AI labels."
        },
        "seniority_signal": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Operating scope, lifecycle ownership, commercial awareness."
        },
        "unsupported_claim_risk": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Inverse-risk score: penalize unsupported metrics/credentials."
        },
        "resume_usefulness": {
          "type": ["number", "null"],
          "minimum": 1,
          "maximum": 5,
          "description": "Hiring-manager usefulness of the executive summary paragraph."
        }
      }
    },
    "human_notes": { "type": "string" },
    "labeler_id": { "type": "string" }
  },
  "required": ["schema_version", "section_id"]
}
