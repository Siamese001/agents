{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-workflow.local/apps_rg/section_quality_review.v1.schema.json",
  "title": "Sealed completed section-quality reviews",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "input_bundle_digest", "reviews", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "apps_rg.section_quality_review.v1"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "input_bundle_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"},
    "reviews": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review"}},
    "bundle_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"}
  },
  "$defs": {
    "dimension_name": {
      "enum": [
        "target_job_relevance", "evidence_fidelity", "achievement_prioritization", "naturalness",
        "professional_voice", "concision", "specificity", "non_contrivance", "ats_compatibility",
        "keyword_use", "jd_parroting_avoidance", "unsupported_language_avoidance",
        "repetition_avoidance", "internal_coherence"
      ]
    },
    "dimension_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "reason", "evidence_refs"],
      "properties": {
        "score": {"type": "number", "minimum": 1, "maximum": 5},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "dimension_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_job_relevance", "evidence_fidelity", "achievement_prioritization", "naturalness",
        "professional_voice", "concision", "specificity", "non_contrivance", "ats_compatibility",
        "keyword_use", "jd_parroting_avoidance", "unsupported_language_avoidance",
        "repetition_avoidance", "internal_coherence"
      ],
      "properties": {
        "target_job_relevance": {"$ref": "#/$defs/dimension_score"},
        "evidence_fidelity": {"$ref": "#/$defs/dimension_score"},
        "achievement_prioritization": {"$ref": "#/$defs/dimension_score"},
        "naturalness": {"$ref": "#/$defs/dimension_score"},
        "professional_voice": {"$ref": "#/$defs/dimension_score"},
        "concision": {"$ref": "#/$defs/dimension_score"},
        "specificity": {"$ref": "#/$defs/dimension_score"},
        "non_contrivance": {"$ref": "#/$defs/dimension_score"},
        "ats_compatibility": {"$ref": "#/$defs/dimension_score"},
        "keyword_use": {"$ref": "#/$defs/dimension_score"},
        "jd_parroting_avoidance": {"$ref": "#/$defs/dimension_score"},
        "unsupported_language_avoidance": {"$ref": "#/$defs/dimension_score"},
        "repetition_avoidance": {"$ref": "#/$defs/dimension_score"},
        "internal_coherence": {"$ref": "#/$defs/dimension_score"}
      }
    },
    "preference_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_job_relevance", "evidence_fidelity", "achievement_prioritization", "naturalness",
        "professional_voice", "concision", "specificity", "non_contrivance", "ats_compatibility",
        "keyword_use", "jd_parroting_avoidance", "unsupported_language_avoidance",
        "repetition_avoidance", "internal_coherence"
      ],
      "properties": {
        "target_job_relevance": {"$ref": "#/$defs/preference"},
        "evidence_fidelity": {"$ref": "#/$defs/preference"},
        "achievement_prioritization": {"$ref": "#/$defs/preference"},
        "naturalness": {"$ref": "#/$defs/preference"},
        "professional_voice": {"$ref": "#/$defs/preference"},
        "concision": {"$ref": "#/$defs/preference"},
        "specificity": {"$ref": "#/$defs/preference"},
        "non_contrivance": {"$ref": "#/$defs/preference"},
        "ats_compatibility": {"$ref": "#/$defs/preference"},
        "keyword_use": {"$ref": "#/$defs/preference"},
        "jd_parroting_avoidance": {"$ref": "#/$defs/preference"},
        "unsupported_language_avoidance": {"$ref": "#/$defs/preference"},
        "repetition_avoidance": {"$ref": "#/$defs/preference"},
        "internal_coherence": {"$ref": "#/$defs/preference"}
      }
    },
    "preference": {"enum": ["VARIANT_A", "VARIANT_B", "TIE", "UNKNOWN"]},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id", "case_id", "section_id", "mode", "candidate_content_digest", "baseline_content_digest",
        "reviewer_class", "reviewer_identity_ref",
        "rubric_id", "rubric_digest", "dimension_scores", "dimension_preferences",
        "overall_preference", "material_worse_dimensions", "review_digest"
      ],
      "properties": {
        "review_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "section_id": {
          "enum": ["headline", "executive_summary", "competencies", "unify_bullets", "ibm_bullets"]
        },
        "mode": {"enum": ["ABSOLUTE", "PAIRWISE"]},
        "candidate_content_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"},
        "baseline_content_digest": {
          "type": ["string", "null"],
          "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
        },
        "reviewer_class": {"enum": ["HUMAN", "MODEL_JUDGE"]},
        "reviewer_identity_ref": {"type": "string", "minLength": 1},
        "rubric_id": {"type": "string", "minLength": 1},
        "rubric_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"},
        "dimension_scores": {"$ref": "#/$defs/dimension_scores"},
        "dimension_preferences": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/preference_map"}]},
        "overall_preference": {"enum": ["NOT_APPLICABLE", "VARIANT_A", "VARIANT_B", "TIE", "UNKNOWN"]},
        "material_worse_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/dimension_name"}
        },
        "review_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "ABSOLUTE"}}, "required": ["mode"]},
          "then": {
            "properties": {
              "dimension_preferences": {"type": "null"},
              "overall_preference": {"const": "NOT_APPLICABLE"},
              "material_worse_dimensions": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "PAIRWISE"}}, "required": ["mode"]},
          "then": {
            "properties": {
              "dimension_preferences": {"$ref": "#/$defs/preference_map"},
              "overall_preference": {"enum": ["VARIANT_A", "VARIANT_B", "TIE", "UNKNOWN"]}
            }
          }
        }
      ]
    }
  }
}
