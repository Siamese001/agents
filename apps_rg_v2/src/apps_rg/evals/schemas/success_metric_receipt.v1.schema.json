{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-workflow.local/apps_rg/success_metric_receipt.v1.schema.json",
  "title": "Apps RG W0 success metric readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "contract_digest",
    "evaluation_id",
    "authority",
    "hard_prerequisites",
    "outcomes",
    "guardrails",
    "diagnostic_gates",
    "promotion_eligible",
    "blocking_reasons",
    "record_digest"
  ],
  "properties": {
    "schema_version": {"const": "apps_rg.success_metric_receipt.v1"},
    "contract_version": {"const": "apps_rg.success_metric_contract.v1"},
    "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "technical_validation", "human_qualified", "release_authorized", "production_authorized", "release_authorizing"],
      "properties": {
        "tier": {"const": "technical_validation"},
        "technical_validation": {"const": true},
        "human_qualified": {"const": false},
        "release_authorized": {"const": false},
        "production_authorized": {"const": false},
        "release_authorizing": {"const": false}
      }
    },
    "hard_prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apps_research_to_u0"],
      "properties": {
        "apps_research_to_u0": {"$ref": "#/$defs/prerequisite"}
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["P1", "P2"],
      "properties": {
        "P1": {"$ref": "#/$defs/outcome"},
        "P2": {"$ref": "#/$defs/outcome"}
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsupported_material_claim_count", "critical_binding_error_count", "critical_run_divergence_count"],
      "properties": {
        "unsupported_material_claim_count": {"$ref": "#/$defs/unmeasured_item"},
        "critical_binding_error_count": {"$ref": "#/$defs/unmeasured_item"},
        "critical_run_divergence_count": {"$ref": "#/$defs/unmeasured_item"}
      }
    },
    "diagnostic_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["G1", "G2", "G3", "G4", "G5", "G6"],
      "properties": {
        "G1": {"$ref": "#/$defs/diagnostic_gate"},
        "G2": {"$ref": "#/$defs/diagnostic_gate"},
        "G3": {"$ref": "#/$defs/diagnostic_gate"},
        "G4": {"$ref": "#/$defs/diagnostic_gate"},
        "G5": {"$ref": "#/$defs/diagnostic_gate"},
        "G6": {"$ref": "#/$defs/diagnostic_gate"}
      }
    },
    "promotion_eligible": {"const": false},
    "blocking_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    },
    "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed", "valid", "reason_codes"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "observed": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "status", "reason_codes"],
      "properties": {
        "metric_id": {"enum": ["blind_finished_resume_utility_delta", "grounded_decision_ready_completion_rate"]},
        "status": {"const": "NOT_MEASURED"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "unmeasured_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"const": "NOT_MEASURED"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "diagnostic_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority"],
      "properties": {
        "status": {"const": "NOT_MEASURED"},
        "authority": {"const": "diagnostic_only"}
      }
    }
  }
}
