{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-workflow.local/apps_rg/finished_resume_outcome.v1.schema.json",
  "title": "Apps RG W4 finished-resume P1 outcome manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "outcome_id", "required_lanes", "review_protocol", "noninferiority_margins", "p1_evidence", "owner_solo_status"],
  "properties": {
    "schema_version": {"const": "apps_rg.finished_resume_outcome.v1"},
    "outcome_id": {"const": "P1"},
    "required_lanes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "review_protocol": {"$ref": "#/$defs/protocol"},
    "noninferiority_margins": {"$ref": "#/$defs/margins"},
    "p1_evidence": {"$ref": "#/$defs/evidence"},
    "owner_solo_status": {"enum": ["NOT_SUPPLIED", "PRESENT_COMPLEMENTARY"]}
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blinded", "independent_primary_reviewers_per_pair", "independent_adjudicators_per_pair", "frozen_baseline_required", "candidate_preference_required", "utility_superiority_required"],
      "properties": {
        "blinded": {"const": true},
        "independent_primary_reviewers_per_pair": {"const": 2},
        "independent_adjudicators_per_pair": {"const": 1},
        "frozen_baseline_required": {"const": true},
        "candidate_preference_required": {"const": true},
        "utility_superiority_required": {"const": true}
      }
    },
    "margins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authenticity", "grounding", "ats", "readability", "concision", "target_relevance"],
      "properties": {
        "authenticity": {"type": ["number", "null"], "minimum": 0},
        "grounding": {"type": ["number", "null"], "minimum": 0},
        "ats": {"type": ["number", "null"], "minimum": 0},
        "readability": {"type": ["number", "null"], "minimum": 0},
        "concision": {"type": ["number", "null"], "minimum": 0},
        "target_relevance": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "pair_count", "primary_review_count", "adjudication_count", "external_authority_receipt_sha256", "completed_review_receipt_digest", "utility_effect", "utility_ci_lower", "candidate_preference_count", "baseline_preference_count", "dimension_ci_lowers", "blind_review_ledger_path", "blind_review_ledger_file_sha256", "synthetic_grades_created"],
      "properties": {
        "status": {"enum": ["PENDING", "COMPLETE"]},
        "pair_count": {"type": "integer", "minimum": 0},
        "primary_review_count": {"type": "integer", "minimum": 0},
        "adjudication_count": {"type": "integer", "minimum": 0},
        "external_authority_receipt_sha256": {"type": "string"},
        "completed_review_receipt_digest": {"type": "string"},
        "utility_effect": {"type": ["number", "null"]},
        "utility_ci_lower": {"type": ["number", "null"]},
        "candidate_preference_count": {"type": "integer", "minimum": 0},
        "baseline_preference_count": {"type": "integer", "minimum": 0},
        "dimension_ci_lowers": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "blind_review_ledger_path": {"type": "string"},
        "blind_review_ledger_file_sha256": {"type": "string"},
        "synthetic_grades_created": {"const": false}
      }
    }
  }
}
