{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-workflow.local/apps_rg/evaluation_gate_result.v1.schema.json",
  "title": "Apps RG named evaluation gate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "gate_id",
    "evaluation_question",
    "score_groups",
    "status",
    "authority",
    "measurement_scope",
    "evidence",
    "metrics",
    "failure_codes",
    "unknown_reasons",
    "unmeasured_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "apps_rg.evaluation_gate_result.v1"
    },
    "contract_version": {
      "const": "apps_rg.evaluation_contract.v2"
    },
    "gate_id": {
      "enum": ["G1", "G2", "G3", "G4", "G5", "G6"]
    },
    "evaluation_question": {
      "type": "string",
      "minLength": 1
    },
    "score_groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "retrieval_quality",
          "binding_accuracy",
          "factual_grounding",
          "section_quality",
          "whole_resume_quality",
          "runtime_repeatability",
          "evaluator_validity"
        ]
      }
    },
    "status": {
      "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_MEASURED"]
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "measurement_scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/metric_result"
      }
    },
    "failure_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "unknown_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unmeasured_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "PASS"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1,
            "items": {
              "properties": {
                "valid": {"const": true},
                "trusted": {"const": true}
              }
            }
          },
          "metrics": {
            "minProperties": 1,
            "additionalProperties": {
              "properties": {
                "status": {"enum": ["PASS", "INFORMATIONAL"]}
              }
            }
          },
          "failure_codes": {"maxItems": 0},
          "unknown_reasons": {"maxItems": 0},
          "unmeasured_reasons": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "FAIL"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failure_codes": {"minItems": 1},
          "unknown_reasons": {"maxItems": 0},
          "unmeasured_reasons": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "UNKNOWN"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failure_codes": {"maxItems": 0},
          "unknown_reasons": {"minItems": 1},
          "unmeasured_reasons": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "NOT_MEASURED"}
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failure_codes": {"maxItems": 0},
          "unknown_reasons": {"maxItems": 0},
          "unmeasured_reasons": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "human_review_required",
        "human_review_satisfied",
        "promotion_scope",
        "release_authorizing"
      ],
      "properties": {
        "classification": {
          "enum": [
            "advisory",
            "conditionally_release_authoritative",
            "release_authoritative"
          ]
        },
        "human_review_required": {
          "type": "boolean"
        },
        "human_review_satisfied": {
          "type": ["boolean", "null"]
        },
        "promotion_scope": {
          "enum": ["future_runs_only", "current_run", "none"]
        },
        "release_authorizing": {
          "type": "boolean"
        },
        "authority_receipt_ref": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "artifact_id", "valid", "trusted"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "valid": {
          "type": "boolean"
        },
        "trusted": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "anyOf": [
        {"required": ["digest"]},
        {"required": ["locator"]}
      ]
    },
    "metric_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": {
          "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_MEASURED", "INFORMATIONAL"]
        },
        "value": {
          "type": ["number", "integer", "string", "boolean", "null"]
        },
        "unit": {
          "type": "string"
        },
        "threshold": {
          "type": ["number", "integer", "string", "boolean", "null"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
