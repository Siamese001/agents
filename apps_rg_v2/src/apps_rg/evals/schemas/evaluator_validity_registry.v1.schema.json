{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-workflow.local/apps_rg/evaluator_validity_registry.v1.schema.json",
  "title": "Apps RG W5 release-affecting evaluator registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "cards"],
  "properties": {
    "schema_version": {"const": "apps_rg.evaluator_validity_registry.v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/card"}}
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grader_id", "version", "scope", "validation_status", "mutation_suite", "human_pilot", "slices", "thresholds"],
      "properties": {
        "grader_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["NOT_MEASURED", "VALIDATED"]},
        "mutation_suite": {"$ref": "#/$defs/mutation_suite"},
        "human_pilot": {"$ref": "#/$defs/human_pilot"},
        "slices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "thresholds": {"$ref": "#/$defs/thresholds"}
      }
    },
    "mutation_suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version"],
      "properties": {
        "status": {"enum": ["PENDING", "COMPLETE"]},
        "version": {"type": "string"}
      }
    },
    "human_pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_digest", "sample_count", "false_pass_count", "false_fail_count", "synthetic_human_labels_created"],
      "properties": {
        "status": {"enum": ["PENDING", "COMPLETE"]},
        "receipt_digest": {"type": "string"},
        "sample_count": {"type": "integer", "minimum": 0},
        "false_pass_count": {"type": "integer", "minimum": 0},
        "false_fail_count": {"type": "integer", "minimum": 0},
        "synthetic_human_labels_created": {"const": false}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_false_pass_upper_bound_max", "false_fail_upper_bound_max", "confidence_level"],
      "properties": {
        "critical_false_pass_upper_bound_max": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "false_fail_upper_bound_max": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence_level": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    }
  }
}
