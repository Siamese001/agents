{
  "agents-implementation-plan-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hook_dispatch.py --hook pre_edit_plan",
            "timeout": 30
          }
        ]
      }
    ]
  },
