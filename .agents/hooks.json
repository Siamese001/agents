{
  "agents-file-write-guard": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file|create_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hook_dispatch.py --hook pre_file_write",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "agents-hitl-atomic-guard": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 tools/hook_dispatch.py --hook post_invocation",
        "timeout": 15
      }
    ]
  },
  "agents-subagent-delegation-guard": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|browser_subagent|start_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hook_dispatch.py --hook pre_subagent_delegation",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "invoke_subagent|browser_subagent|start_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/hook_dispatch.py --hook post_subagent_delegation",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
